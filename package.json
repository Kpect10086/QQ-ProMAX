{
  "name": "cortico-world-qq-promax",
  "version": "0.3.0",
  "description": "QQ ProMAX: Cortico QQ 私聊、群聊与语音发送；空间和语音输入独立安装。",
  "type": "module",
  "main": "./src/index.ts",
  "license": "AGPL-3.0-or-later",
  "keywords": [
    "cortico-world",
    "cortico",
    "qq",
    "onebot",
    "snowluma",
    "napcat",
    "qq-promax"
  ],
  "engines": {
    "node": ">=22.16.0"
  },
  "files": [
    "src",
    "dist/webui.js",
    "ENV_PROMPT.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "CHANGELOG.md",
    "describe.json",
    "LICENSE-MIT"
  ],
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "QQ ProMAX",
    "webUiClient": "dist/webui.js",
    "describe": "describe.json",
    "tags": [
      "im",
      "qq",
      "voice",
      "memory",
      "local",
      "external-setup",
      "internal-state",
      "unofficial-api",
      "experimental"
    ],
    "locales": {
      "zh": {
        "displayName": "QQ ProMAX"
      },
      "en": {
        "displayName": "QQ ProMAX"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "cortico": "0.2.6",
    "tsx": "^4.19.2",
    "esbuild": "^0.28.1",
    "typescript": "^5.7.2",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "vitest": "^2.1.8",
    "jsdom": "^30.0.1"
  },
  "os": [
    "win32",
    "linux"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kpect10086/QQ-ProMAX.git"
  },
  "homepage": "https://github.com/Kpect10086/QQ-ProMAX#readme",
  "bugs": {
    "url": "https://github.com/Kpect10086/QQ-ProMAX/issues"
  },
  "scripts": {
    "test": "node tests/host-free.mjs && vitest run",
    "test:package": "node tests/packaged-install.mjs",
    "test:asr": "python -m unittest discover -s packages/qq-audio-input/tests -p test_asr_sidecar.py -v",
    "build:web": "esbuild src/console/client.ts --bundle --format=esm --outfile=dist/webui.js",
    "typecheck": "tsc --noEmit",
    "build:qzone": "esbuild packages/qq-qzone/src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=packages/qq-qzone/dist/index.mjs"
  }
}
